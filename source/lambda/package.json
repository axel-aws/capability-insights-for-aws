{
  "name": "@capability-insights/lambda",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc || true",
    "build:refresh": "tsc -p tsconfig.refresh.json || true",
    "clean": "rm -rf dist dist-refresh",
    "prepackage": "mkdir -p dist/node_modules && cp -r ../../node_modules/js-yaml dist/node_modules/",
    "package": "cd dist && zip -r ../../../deployment/dist/lambda/lambdaAssets.zip lambda shared node_modules",
    "package:refresh": "cd dist-refresh && zip -r ../../../deployment/dist/lambda/refreshLambdaAssets.zip lambda shared",
    "postbuild": "npm run build:refresh",
    "postpackage": "npm run package:refresh",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1001.0",
    "@aws-sdk/client-lambda": "^3.1001.0",
    "@aws-sdk/client-s3": "^3.997.0",
    "@types/aws-lambda": "^8.10.160",
    "@types/js-yaml": "^4.0.9",
    "fast-check": "^4.7.0",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.1043.0",
    "@aws-sdk/client-cloudwatch": "^3.1043.0",
    "@aws-sdk/client-dynamodb": "^3.1043.0",
    "@aws-sdk/client-iam": "^3.1043.0",
    "@aws-sdk/client-organizations": "^3.1043.0",
    "@aws-sdk/client-secrets-manager": "^3.1043.0",
    "@aws-sdk/client-sfn": "^3.1043.0",
    "@aws-sdk/lib-dynamodb": "^3.1043.0",
    "aws-sdk-client-mock": "^4.1.0",
    "js-yaml": "^4.1.0"
  }
}
